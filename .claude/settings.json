{
  "permissions": {
    "deny": ["Read(./.env)", "Read(./.env.local)", "Read(./.dev.vars)", "Bash(git push --force:*)", "Bash(git push -f:*)"]
  },
  "hooks": {
    "PreToolUse": [
      { "matcher": "Bash|Read|Edit|Write", "hooks": [{ "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard.sh" }] }
    ]
  }
}
