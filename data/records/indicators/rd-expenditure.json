{
  "id": "rd-expenditure",
  "category": "innovation-industry",
  "name": {
    "en": "Research and development spending",
    "hi": "अनुसंधान और विकास पर खर्च"
  },
  "definition": {
    "en": "Spending on research and development by government, business, universities and non-profits, as a share of GDP.",
    "hi": "सरकार, व्यवसायों, विश्वविद्यालयों और गैर-लाभकारी संस्थाओं द्वारा अनुसंधान और विकास पर खर्च, जीडीपी के प्रतिशत के रूप में।"
  },
  "unit": {
    "en": "% of GDP",
    "hi": "जीडीपी का %"
  },
  "direction": "higher",
  "geography": "IN",
  "methodology": {
    "en": "World Bank World Development Indicators (GB.XPD.RSDV.GD.ZS), from the UNESCO Institute for Statistics, based on Department of Science and Technology surveys.",
    "hi": "विश्व बैंक विश्व विकास संकेतक (GB.XPD.RSDV.GD.ZS), यूनेस्को सांख्यिकी संस्थान से, विज्ञान और प्रौद्योगिकी विभाग के सर्वेक्षणों पर आधारित।"
  },
  "limitations": {
    "en": "Published with a delay of several years. Business research spending is harder to measure than government spending.",
    "hi": "कई वर्षों की देरी से प्रकाशित। व्यवसायों का अनुसंधान खर्च सरकारी खर्च की तुलना में मापना कठिन है।"
  },
  "sourceId": "world-bank-api",
