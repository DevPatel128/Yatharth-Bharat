{
  "id": "maternal-mortality",
  "category": "healthcare",
  "name": {
    "en": "Maternal mortality ratio",
    "hi": "मातृ मृत्यु अनुपात"
  },
  "definition": {
    "en": "Women who die from pregnancy-related causes during pregnancy or within 42 days after it, per 100,000 live births.",
    "hi": "गर्भावस्था के दौरान या उसके 42 दिनों के भीतर गर्भावस्था से जुड़े कारणों से मरने वाली महिलाएं, प्रति 100,000 जीवित जन्म।"
  },
  "unit": {
    "en": "deaths per 100,000 live births",
    "hi": "मौतें प्रति 100,000 जीवित जन्म"
  },
  "direction": "lower",
  "geography": "IN",
  "methodology": {
    "en": "World Bank World Development Indicators (SH.STA.MMRT), from the UN Maternal Mortality Estimation Inter-Agency Group (modelled estimate).",
    "hi": "विश्व बैंक विश्व विकास संकेतक (SH.STA.MMRT), संयुक्त राष्ट्र मातृ मृत्यु दर आकलन अंतर-एजेंसी समूह से (मॉडल आधारित अनुमान)।"
  },
  "limitations": {
    "en": "A modelled international estimate. India’s official figure comes from the Sample Registration System of the Registrar General and is published for three-year periods.",
    "hi": "मॉडल आधारित अंतरराष्ट्रीय अनुमान। भारत का आधिकारिक आंकड़ा महापंजीयक की नमूना पंजीकरण प्रणाली से आता है और तीन वर्ष की अवधि के लिए प्रकाशित होता है।"
  },
  "sourceId": "world-bank-api",
