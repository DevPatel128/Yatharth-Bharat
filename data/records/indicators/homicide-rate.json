{
  "id": "homicide-rate",
  "category": "public-safety-justice",
  "name": {
    "en": "Intentional homicides",
    "hi": "जानबूझकर की गई हत्याएं"
  },
  "definition": {
    "en": "Unlawful deaths deliberately inflicted on a person, per 100,000 people, as recorded by police.",
    "hi": "किसी व्यक्ति की जानबूझकर की गई गैरकानूनी मौतें, प्रति 100,000 लोग, पुलिस रिकॉर्ड के अनुसार।"
  },
  "unit": {
    "en": "per 100,000 people",
    "hi": "प्रति 100,000 लोग"
  },
  "direction": "lower",
  "geography": "IN",
  "methodology": {
    "en": "World Bank World Development Indicators (VC.IHR.PSRC.P5), from the UN Office on Drugs and Crime, based on National Crime Records Bureau data.",
    "hi": "विश्व बैंक विश्व विकास संकेतक (VC.IHR.PSRC.P5), संयुक्त राष्ट्र ड्रग्स और अपराध कार्यालय से, राष्ट्रीय अपराध रिकॉर्ड ब्यूरो के आंकड़ों पर आधारित।"
  },
  "limitations": {
    "en": "Based on cases recorded by police; recording practices differ between states and over time. The National Crime Records Bureau’s annual Crime in India report is the primary source.",
    "hi": "पुलिस द्वारा दर्ज मामलों पर आधारित; दर्ज करने की प्रथाएं राज्यों और समय के साथ बदलती हैं। राष्ट्रीय अपराध रिकॉर्ड ब्यूरो की वार्षिक रिपोर्ट \"भारत में अपराध\" प्राथमिक स्रोत है।"
  },
