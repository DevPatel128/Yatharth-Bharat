{
  "id": "health-expenditure",
  "category": "healthcare",
  "name": {
    "en": "Current health expenditure",
    "hi": "वर्तमान स्वास्थ्य व्यय"
  },
  "definition": {
    "en": "All current spending on health in India, by government, households, employers and others, as a share of GDP.",
    "hi": "भारत में स्वास्थ्य पर सभी वर्तमान खर्च, सरकार, परिवारों, नियोक्ताओं और अन्य द्वारा, जीडीपी के प्रतिशत के रूप में।"
  },
  "unit": {
    "en": "% of GDP",
    "hi": "जीडीपी का %"
  },
  "direction": "neutral",
  "geography": "IN",
  "methodology": {
    "en": "World Bank World Development Indicators (SH.XPD.CHEX.GD.ZS), from the WHO Global Health Expenditure Database.",
    "hi": "विश्व बैंक विश्व विकास संकेतक (SH.XPD.CHEX.GD.ZS), WHO वैश्विक स्वास्थ्य व्यय डेटाबेस से।"
  },
  "limitations": {
    "en": "Includes private and out-of-pocket spending, not only government spending. India’s own National Health Accounts estimates are published by the Ministry of Health and can differ.",
    "hi": "इसमें निजी और जेब से किया गया खर्च भी शामिल है, केवल सरकारी खर्च नहीं। भारत के राष्ट्रीय स्वास्थ्य लेखा अनुमान स्वास्थ्य मंत्रालय प्रकाशित करता है और वे भिन्न हो सकते हैं।"
  },
  "sourceId": "world-bank-api",
