{
  "id": "education-expenditure",
  "category": "education",
  "name": {
    "en": "Government spending on education",
    "hi": "शिक्षा पर सरकारी खर्च"
  },
  "definition": {
    "en": "Spending on education by the Union, state and local governments, as a share of GDP.",
    "hi": "केंद्र, राज्य और स्थानीय सरकारों द्वारा शिक्षा पर खर्च, जीडीपी के प्रतिशत के रूप में।"
  },
  "unit": {
    "en": "% of GDP",
    "hi": "जीडीपी का %"
  },
  "direction": "neutral",
  "geography": "IN",
  "methodology": {
    "en": "World Bank World Development Indicators (SE.XPD.TOTL.GD.ZS), from the UNESCO Institute for Statistics, based on the Ministry of Education’s Analysis of Budgeted Expenditure.",
    "hi": "विश्व बैंक विश्व विकास संकेतक (SE.XPD.TOTL.GD.ZS), यूनेस्को सांख्यिकी संस्थान से, शिक्षा मंत्रालय के बजटीय व्यय विश्लेषण पर आधारित।"
  },
  "limitations": {
    "en": "Covers government spending only, not what families spend on private schooling and coaching.",
    "hi": "इसमें केवल सरकारी खर्च शामिल है, निजी स्कूलों और कोचिंग पर परिवारों का खर्च नहीं।"
  },
  "sourceId": "world-bank-api",
