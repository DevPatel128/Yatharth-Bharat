{
  "id": "forest-area",
  "category": "environment",
  "name": {
    "en": "Forest area",
    "hi": "वन क्षेत्र"
  },
  "definition": {
    "en": "Land under natural or planted trees at least 5 metres high, as a share of total land area.",
    "hi": "कम से कम 5 मीटर ऊंचे प्राकृतिक या लगाए गए पेड़ों वाली भूमि, कुल भूमि क्षेत्र के प्रतिशत के रूप में।"
  },
  "unit": {
    "en": "% of land area",
    "hi": "भूमि क्षेत्र का %"
  },
  "direction": "higher",
  "geography": "IN",
  "methodology": {
    "en": "World Bank World Development Indicators (AG.LND.FRST.ZS), from the UN Food and Agriculture Organization Global Forest Resources Assessment.",
    "hi": "विश्व बैंक विश्व विकास संकेतक (AG.LND.FRST.ZS), संयुक्त राष्ट्र खाद्य और कृषि संगठन के वैश्विक वन संसाधन आकलन से।"
  },
  "limitations": {
    "en": "Uses the FAO definition. The Forest Survey of India’s State of Forest Report uses satellite-based forest and tree cover and gives different figures.",
    "hi": "इसमें FAO की परिभाषा उपयोग होती है। भारतीय वन सर्वेक्षण की वन स्थिति रिपोर्ट उपग्रह-आधारित वन और वृक्ष आवरण का उपयोग करती है और अलग आंकड़े देती है।"
  },
