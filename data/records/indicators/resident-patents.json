{
  "id": "resident-patents",
  "category": "innovation-industry",
  "name": {
    "en": "Patent applications by residents",
    "hi": "निवासियों द्वारा पेटेंट आवेदन"
  },
  "definition": {
    "en": "Patent applications filed in India by people and organisations resident in India in a year.",
    "hi": "एक वर्ष में भारत में रहने वाले व्यक्तियों और संगठनों द्वारा भारत में दायर पेटेंट आवेदन।"
  },
  "unit": {
    "en": "applications",
    "hi": "आवेदन"
  },
  "direction": "neutral",
  "geography": "IN",
  "methodology": {
    "en": "World Bank World Development Indicators (IP.PAT.RESD), from the World Intellectual Property Organization, based on the Indian Patent Office.",
    "hi": "विश्व बैंक विश्व विकास संकेतक (IP.PAT.RESD), विश्व बौद्धिक संपदा संगठन से, भारतीय पेटेंट कार्यालय के आधार पर।"
  },
  "limitations": {
    "en": "Counts applications, not patents granted, and says nothing about their value or use.",
    "hi": "यह आवेदन गिनता है, स्वीकृत पेटेंट नहीं, और उनके मूल्य या उपयोग के बारे में कुछ नहीं बताता।"
  },
  "sourceId": "world-bank-api",
