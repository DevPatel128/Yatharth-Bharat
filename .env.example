# Names only. Real values go in GitHub encrypted secrets / variables or `wrangler secret put`. Never commit .env or .dev.vars.
# Pipeline (GitHub Actions secret)
ANTHROPIC_API_KEY=
# Pipeline mode: true in the scheduled workflow (AI gates required to publish)
REQUIRE_AI_GATES=false
# Data bot GitHub App (variable DATA_BOT_APP_ID, secret DATA_BOT_PRIVATE_KEY)
DATA_BOT_APP_ID=
DATA_BOT_PRIVATE_KEY=
# Optional source keys (adapters switch on when set; owner self-registers)
DATA_GOV_IN_API_KEY=
UNDP_HDR_API_KEY=
# Browser telemetry (build-time; public by nature, low-privilege keys only)
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
# CI only
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
SENTRY_AUTH_TOKEN=
# GitHub repo variables (not secrets): PROD_URL · SENTRY_PROJECT=<org>/<project> · AUTOPILOT=on|off · DATA_BOT_APP_ID
