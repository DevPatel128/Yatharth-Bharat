# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Cloudflare / OpenNext

/.wrangler/
.dev.vars*
!.dev.vars.example
# pipeline scratch
/.cache/
/playwright-report/
/test-results/

!.env.example
/out/

# manual-inbox: keep source notes, not the downloaded files
/data/manual-inbox/**/*.pdf
/data/manual-inbox/**/*.xlsx
/data/manual-inbox/**/*.zip
# Budget at a Glance is small (under 3 MB) and kept in git so CI can re-verify it and run the AI review
!/data/manual-inbox/budget/*.pdf
!/data/manual-inbox/budget/*.xlsx

# Raw downloads stay in the project folder but out of git (size); the README explains them
/data/raw/*
!/data/raw/README.md

# Browser-pane downloads land in the project root; official copies live in data/manual-inbox/
/*.pdf
/*.xlsx
